# The mobile app is its own separate git repo (has its own .git/) —
# excluded here so this repo doesn't try to nest/swallow it.
mobile/

# --- Backend (Python) ---
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/uploads/
backend/*.db
backend/.pytest_cache/
backend/.mypy_cache/

# --- Web (Node) ---
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local
web/.env

# --- OS / editor ---
.DS_Store
*.swp

# --- Internal working docs ---
# Dev-facing notes (changelog, roadmap, deploy/setup steps written as
# instructions to the project owner) -- useful locally, not meant for
# a public repo a recruiter or user might land on. Kept on disk, just
# untracked; see README.md for the public-facing project description.
docs/

# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

# --- Database ---
# Matches the credentials in docker-compose.yml (dev-only, not real secrets).
DATABASE_URL=postgresql://receipts_user:receipts_dev_pw@db:5432/receipts_db

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- File storage ---
UPLOAD_DIR=/app/uploads
